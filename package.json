{
  "name": "pi-role-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Role-specialized coding-agent runtime on Pi: event-driven planner, persistent coding worker, Project IR, structured contracts, sandboxed execution and deterministic verification.",
  "bin": {
    "pi-role-harness": "./dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check:syntax": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.26",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "tsx": "4.20.5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "prompts/",
    "docs/",
    "role-harness.config.example.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "keywords": [
    "pi",
    "coding-agent",
    "orchestration",
    "multi-agent",
    "harness"
  ]
}
